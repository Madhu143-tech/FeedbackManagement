@model IEnumerable<FeedbackManagementMVC.Models.Feedback>
@{
    ViewData["Title"] = "Feedback Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge text-bg-primary text-uppercase">Module Overview</span>
        <h1 class="h2 mt-2 fw-bold">Student Feedback Management</h1>
        <p class="text-muted mb-0">View feedback records or submit a new response.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary px-3 py-2">+ Add New Feedback</a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">#</th><th>Student Name</th><th>Category</th>
                    <th>Rating</th><th>Comments</th><th>Submitted On</th><th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4 fw-bold text-muted">@item.Id</td>
                    <td><div class="fw-semibold">@item.StudentName</div><small class="text-muted">@item.Email</small></td>
                    <td><span class="badge text-bg-info">@item.Category</span></td>
                    <td><span class="stars">@(new string('★', Math.Clamp(item.Rating, 0, 5)))</span> <small>(@item.Rating/5)</small></td>
                    <td class="comment-cell">@item.Comments</td>
                    <td>@item.SubmissionDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                    <td class="text-center"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
